---
const nav = [
  { label: 'Approach', href: '/approach/' },
  { label: 'Frameworks', href: '/frameworks/' },
  { label: 'Legibility Score', href: '/legibility-score/' },
  { label: 'Services', href: '/services/' },
  { label: 'Manifesto', href: '/manifesto/' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-main">ZORDERE</span>
      <span class="logo-sub">Communication Intelligence</span>
    </a>
    <nav class="nav-desktop">
      {nav.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
      <a href="mailto:hello@zordere.com" class="btn-primary nav-cta">Commission a Diagnostic</a>
    </nav>
    <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav">
      {nav.map(item => (
        <a href={item.href} class="mobile-nav-link">{item.label}</a>
      ))}
      <a href="mailto:hello@zordere.com" class="btn-primary mobile-cta">Commission a Diagnostic</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    toggle.classList.toggle('open', isOpen);
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.classList.remove('open');
    toggle?.classList.remove('open');
    document.body.style.overflow = '';
  }));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15,27,28,0.92);
    backdrop-filter: blur(10px);
    border-bottom: var(--border-thin);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
  }
  .logo { text-decoration: none; display: flex; flex-direction: column; line-height: 1; }
  .logo-main { font-family: var(--display); font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ivory); }
  .logo-sub { font-family: var(--mono); font-size: 0.55rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--aegean-light); margin-top: 4px; }

  .nav-desktop { display: flex; align-items: center; gap: 28px; }
  .nav-link { font-family: var(--font-nav); font-size: 0.82rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; color: var(--ivory); transition: color 0.2s; }
  .nav-link:hover { color: var(--aegean-light); }
  .nav-cta { font-family: var(--font-nav); padding: 10px 18px; font-size: 0.72rem; }

  /* ── Hamburger toggle ─────────────────────────────────── */
  .menu-toggle {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 40px; height: 40px; background: none; border: none; cursor: pointer; padding: 0;
  }
  .menu-toggle span {
    display: block; width: 22px; height: 1.5px; background: var(--ivory);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .menu-toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Mobile menu panel ────────────────────────────────── */
  .mobile-menu {
    display: none;
    position: fixed; inset: 0; top: 60px; z-index: 90;
    background: var(--ink, #0F1B1C);
    transform: translateY(-8px); opacity: 0; pointer-events: none;
    transition: transform 0.25s ease, opacity 0.2s ease;
    overflow-y: auto;
  }
  .mobile-menu.open { transform: translateY(0); opacity: 1; pointer-events: auto; }
  .mobile-nav { display: flex; flex-direction: column; padding: 12px 28px 40px; }
  .mobile-nav-link {
    font-family: var(--font-nav); font-size: 1.1rem; font-weight: 500;
    color: var(--ivory); text-decoration: none; padding: 18px 0;
    border-bottom: 1px solid var(--line, rgba(244,240,230,0.09));
  }
  .mobile-cta { font-family: var(--font-nav); margin-top: 28px; text-align: center; padding: 15px; }

  @media (max-width: 900px) {
    .nav-desktop { display: none; }
    .menu-toggle { display: flex; }
    .mobile-menu { display: block; }
  }
</style>

