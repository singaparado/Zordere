---
const nav = [
  { label: 'Approach', href: '/approach/' },
  { label: 'Frameworks', href: '/frameworks/' },
  { label: 'Legibility Score', href: '/legibility-score/' },
  { label: 'Services', href: '/services/' },
  { label: 'Manifesto', href: '/manifesto/' },
];
---
<header class="site-header">
  <input type="checkbox" id="menu-toggle" class="menu-checkbox" />
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-main">ZORDERE</span>
      <span class="logo-sub">Communication Intelligence</span>
    </a>
    <nav class="nav-desktop">
      {nav.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
      <a href="mailto:hello@zordere.com" class="btn-primary nav-cta">Commission a Diagnostic</a>
    </nav>
    <label for="menu-toggle" class="menu-toggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>
  </div>

  <nav class="mobile-menu">
    {nav.map(item => (
      <a href={item.href} class="mobile-nav-link">{item.label}</a>
    ))}
    <a href="mailto:hello@zordere.com" class="btn-primary" style="display:block; margin-top:28px; text-align:center;">Commission a Diagnostic</a>
  </nav>
</header>

<style>
  .menu-checkbox { display: none; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15,27,28,0.94);
    backdrop-filter: blur(10px);
    border-bottom: var(--border-thin);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
  }
  .logo { text-decoration: none; display: flex; flex-direction: column; line-height: 1; }
  .logo-main { font-family: var(--font-nav); font-size: 1.2rem; font-weight: 700; letter-spacing: 0.02em; color: var(--ivory); }
  .logo-sub { font-family: var(--mono); font-size: 0.55rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--aegean-light); margin-top: 4px; }

  .nav-desktop { display: flex; align-items: center; gap: 28px; }
  .nav-link { font-family: var(--font-nav); font-size: 0.82rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none; color: var(--ivory); transition: color 0.2s; }
  .nav-link:hover { color: var(--gold); }
  .nav-cta { padding: 10px 18px; font-size: 0.72rem; }

  .menu-toggle {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 40px; height: 40px; background: none; border: none; cursor: pointer; padding: 0;
  }
  .menu-toggle span {
    display: block; width: 22px; height: 1.5px; background: var(--ivory);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .menu-checkbox:checked ~ .header-inner .menu-toggle span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-checkbox:checked ~ .header-inner .menu-toggle span:nth-child(2) { opacity: 0; }
  .menu-checkbox:checked ~ .header-inner .menu-toggle span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0 28px;
    max-height: 0;
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition: max-height 0.28s ease, opacity 0.2s ease, padding 0.28s ease;
  }
  .menu-checkbox:checked ~ .mobile-menu {
    max-height: 500px;
    opacity: 1;
    padding: 12px 28px 40px;
    pointer-events: auto;
  }
  .mobile-nav-link {
    font-family: var(--font-nav); font-size: 1.1rem; font-weight: 500;
    color: var(--ivory); text-decoration: none; padding: 18px 0;
    border-bottom: 1px solid var(--border-thin);
    display: block;
  }

  @media (max-width: 900px) {
    .nav-desktop { display: none; }
    .menu-toggle { display: flex; }
    .mobile-menu { display: flex; }
  }
</style>
